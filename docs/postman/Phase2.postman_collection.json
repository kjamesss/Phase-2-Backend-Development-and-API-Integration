{
  "info": {
    "name": "Phase 2 Backend API",
    "description": "Run in order against local MongoDB and Express. Uses only fictional test data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Database health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('MongoDB connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"API Lab User\",\n  \"email\": \"lab.user.{{runId}}@example.test\",\n  \"password\": \"LabPass123!\",\n  \"role\": \"user\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('runId', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.environment.set('userId', pm.response.json()._id);",
              "pm.test('User created', () => pm.expect(pm.response.json().name).to.eql('API Lab User'));",
              "pm.test('Password hidden', () => pm.expect(pm.response.json()).not.to.have.property('password'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Created user listed', () => pm.expect(pm.response.json().some(x => x._id === pm.environment.get('userId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Read user by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Correct user', () => pm.expect(pm.response.json()._id).to.eql(pm.environment.get('userId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update user",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/users/{{userId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Lab User\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Name updated', () => pm.expect(pm.response.json().name).to.eql('Updated Lab User'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Confirm stored user update",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
