            ]
          }
        }
      ]
    },
    {
      "name": "10 Confirm user deleted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/users/{{userId}}"
      },
      "event": [
        {
          "listen": "test",
